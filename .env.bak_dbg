# ============================================================
# 广盈物业薪酬系统 - 生产环境变量模板
# 部署前请复制为 .env： cp .env.production .env
# 密码字段全部留占位符，在服务器上第一次跑 deploy.sh 前手工填入
# 不要把本文件提交到 git
# ============================================================

APP_NAME="广盈物业薪酬系统"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.88shangcheng.top

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------
# MySQL - 宝塔面板创建数据库后填入
# DB_HOST 宝塔默认 127.0.0.1；如果数据库在另一台服务器改成对应内网 IP
# DB_USERNAME 不要使用 root，宝塔创建专用账号 payroll
# DB_PASSWORD 用 openssl rand -base64 18 现场生成，不要与 SSH 密码相同
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=payroll
DB_PASSWORD=0ea0b4546a0b1e373d6a187990e420d3

# 旧 JSON 数据目录（首次迁移时由 IMPORT_LEGACY=1 触发）
LEGACY_DATA_PATH=../data

# 会话：首次部署会自动 php artisan migrate 生成 sessions 表
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 文件存储：保持 local，文件落在 storage/app/private，禁止改成 public
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# 以下缓存/邮件/云存储/前端变量保持默认即可
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@88shangcheng.top"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
