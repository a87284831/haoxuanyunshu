APP_NAME=薪酬核算系统
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8910

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- 数据库 ----
# 本地开发推荐 SQLite（零安装）：DB_CONNECTION=sqlite，并注释掉 DB_HOST 等行，
# 数据库文件为 database/local.sqlite（首次运行迁移自动创建）
# DB_CONNECTION=sqlite
# 生产 / 类生产环境使用 MySQL：
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=payroll
DB_PASSWORD=

# ---- 遗留配置 JSON 目录（calc_rules/symbols/settings/payslip_config）----
# 相对 laravel-app 根目录；本地克隆后向管理员索取 data/ 目录副本
LEGACY_DATA_PATH=../data

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- 采购/财务库（三库合并后默认与主库同库，仅回滚时需要单独配置）----
PROC_DB_HOST=127.0.0.1
PROC_DB_PORT=3306
PROC_DB_NAME=payroll
PROC_DB_USER=payroll
PROC_DB_PASS=
