# ============================================================
# 薪酬核算系统环境变量模板
# 部署：cp .env.example .env 后逐项填写
# ============================================================

APP_NAME="薪酬核算系统"
APP_ENV=production
# 密钥留空，首次部署执行 php artisan key:generate 自动生成
APP_KEY=
APP_DEBUG=false
# 系统访问地址（https://您的域名），站内消息链接会用到
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------
# MySQL：先在数据库中创建库和专用账号（不要用 root）
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=payroll
DB_PASSWORD=

# 会话/缓存存数据库，无需额外组件
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 采购模块数据库（与主库同库即可）
PROC_DB_HOST=127.0.0.1
PROC_DB_PORT=3306
PROC_DB_NAME=payroll
PROC_DB_USER=payroll
PROC_DB_PASS=
