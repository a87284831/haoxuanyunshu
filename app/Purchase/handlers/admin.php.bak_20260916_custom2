    return ['ok' => true, 'msg' => '已撤销归档，恢复可编辑'];
}

// 清单外列表（is_custom=1 或 秩序条线）
function handle_admin_customs() {
    require_admin();
    $month = $_GET['month'] ?? date('Y-m');
    $st = db()->prepare(
        "SELECT pi.*, p.name AS project_name FROM purchase_items pi
         JOIN payroll.payroll_projects p ON pi.project_id=p.id
         WHERE pi.month=? AND pi.is_custom=1 ORDER BY pi.project_id, pi.line, pi.id"
    );
    $st->execute([$month]);
    $items = $st->fetchAll();
    // 附带商品库匹配候选
    $db = db();
    foreach ($items as &$it) {
        $cand = $db->prepare(
            "SELECT id, line, category, name, brand, spec, unit FROM products
             WHERE status=1 AND (name LIKE ? OR spec LIKE ?) ORDER BY id LIMIT 8"
        );
        $like = "%" . $it['item_name'] . "%";
        $cand->execute([$like, $like]);
        $it['candidates'] = $cand->fetchAll();
    }
    return ['ok' => true, 'data' => $items];
}

// 清单外归类：映射到标准商品（可选保存别名）
function handle_admin_map_custom() {
    require_admin();
    $in = json_decode(file_get_contents('php://input'), true) ?? [];
    $item_id = (int)($in['item_id'] ?? 0);
    $product_id = (int)($in['product_id'] ?? 0);
    $save_alias = !empty($in['save_alias']);
    if ($item_id <= 0) return ['ok' => false, 'msg' => '参数缺失'];
    $item = fetch_item($item_id);
    if (!$item) return ['ok' => false, 'msg' => '记录不存在'];
    if (month_archived($item['month'])) return ['ok' => false, 'msg' => '本月已归档锁定，不可修改'];
    if ($product_id > 0) {
        $pst = db()->prepare("SELECT * FROM products WHERE id=? AND status=1");
        $pst->execute([$product_id]);
        $prod = $pst->fetch();
        if (!$prod) return ['ok' => false, 'msg' => '目标商品不存在'];
        // 更新明细为标准商品
        db()->prepare(
            "UPDATE purchase_items SET product_id=?, item_name=?, brand=?, spec=?, unit=?, is_custom=0 WHERE id=?"
        )->execute([$product_id, $prod['name'], $prod['brand'], $prod['spec'], $prod['unit'], $item_id]);
        // 保存别名
        if ($save_alias && $item['item_name'] !== $prod['name']) {
            try {
                db()->prepare("INSERT IGNORE INTO product_synonyms (product_id, alias) VALUES (?,?)")
                    ->execute([$product_id, $item['item_name']]);
            } catch (PDOException $e) {}
        }
        db()->prepare("INSERT INTO audit_records (item_id, product_id, action, alias_saved, created_by) VALUES (?,?,?,?,?)")
            ->execute([$item_id, $product_id, 'map', $save_alias ? 1 : 0, (int)($in['by'] ?? $in['created_by'] ?? 0)]);
        log_action('清单外映射', "{$item['month']} 项目{$item['project_id']} 「{$item['item_name']}」→ 标准商品「{$prod['name']}」" . ($save_alias ? '（并保存别名）' : ''));
        return ['ok' => true, 'msg' => '已归入标准商品「' . $prod['name'] . '」'];
    }
    return ['ok' => false, 'msg' => '请选择要归入的商品'];
}

// 清单外查重：按名称在标准库检索同名商品（供"编辑入库"前判断；name 必填，其余条件可选）
function handle_admin_customs_check_duplicate() {
    require_admin();
    $in = json_decode(file_get_contents('php://input'), true) ?? $_POST;
    $name = trim((string)($in['name'] ?? ''));
    if ($name === '') return ['ok' => false, 'msg' => '商品名称不能为空'];
    $sql = "SELECT id, line, category, name, brand, spec, unit FROM products WHERE status=1 AND name=?";
    $params = [$name];
    foreach (['line', 'category', 'brand'] as $f) {
        if (!empty($in[$f])) { $sql .= " AND {$f}=?"; $params[] = trim((string)$in[$f]); }
    }
    if (isset($in['spec']) && $in['spec'] !== '' && $in['spec'] !== null) {
        $sql .= " AND spec=?"; $params[] = norm_spec((string)$in['spec']);
    }
    $sql .= " ORDER BY id LIMIT 20";
    $st = db()->prepare($sql);
    $st->execute($params);
    return ['ok' => true, 'data' => $st->fetchAll()];
}

// 清单外"编辑入库"：mode=create 新建标准商品并归入；mode=merge 归入已有商品。别名可自定义（默认员工原填名称）
function handle_admin_customs_save() {
    require_admin();
    $in = json_decode(file_get_contents('php://input'), true) ?? $_POST;
    $item_id = (int)($in['item_id'] ?? 0);
    $mode = trim((string)($in['mode'] ?? ''));
    if ($item_id <= 0) return ['ok' => false, 'msg' => '参数缺失'];
    $item = fetch_item($item_id);
    if (!$item) return ['ok' => false, 'msg' => '记录不存在'];
    if (month_archived($item['month'])) return ['ok' => false, 'msg' => '本月已归档锁定，不可修改'];
    if ($mode !== 'create' && $mode !== 'merge') return ['ok' => false, 'msg' => 'mode 参数错误（create/merge）'];

    // 预校验（不写库）：merge 目标商品存在性 / create 必填与唯一键防重
    $name = ''; $line = ''; $category = ''; $brand = ''; $spec = ''; $unit = ''; $product_id = 0; $prod = null;
    if ($mode === 'merge') {
        $product_id = (int)($in['product_id'] ?? 0);
        if ($product_id <= 0) return ['ok' => false, 'msg' => '请选择要归入的标准商品'];
        $pst = db()->prepare('SELECT * FROM products WHERE id=? AND status=1');
        $pst->execute([$product_id]);
        $prod = $pst->fetch();
        if (!$prod) return ['ok' => false, 'msg' => '目标商品不存在'];
    } else {
        $name = trim((string)($in['name'] ?? ''));
        $line = trim((string)($in['line'] ?? ''));
        $category = trim((string)($in['category'] ?? ''));
        if ($name === '') return ['ok' => false, 'msg' => '商品名称必填'];
        if ($line === '') return ['ok' => false, 'msg' => '条线必填'];
        if ($category === '') return ['ok' => false, 'msg' => '分类必填'];
        $brand = trim((string)($in['brand'] ?? ''));
        $spec = norm_spec($in['spec'] ?? '');
        $unit = trim((string)($in['unit'] ?? ''));
        $dup = db()->prepare('SELECT id, name FROM products WHERE status=1 AND line=? AND category=? AND name=? AND brand=? AND spec=? LIMIT 1');
        $dup->execute([$line, $category, $name, $brand, $spec]);
        $exist = $dup->fetch();
        if ($exist) {
            return ['ok' => false, 'msg' => '标准库已存在相同商品「' . $exist['name'] . '」（条线/分类/名称/品牌/规格完全一致），请选择归入已有'];
        }
    }
    $alias = trim((string)($in['alias'] ?? $item['item_name']));
    $alias = mb_substr($alias, 0, 100);
    $by = (int)($in['by'] ?? $in['created_by'] ?? 0);

    // 写库原子性：单请求内开事务；外层已有事务（测试）则不嵌套
    $tx = !db()->inTransaction();
    if ($tx) db()->beginTransaction();
    try {
        if ($mode === 'merge') {
            db()->prepare('UPDATE purchase_items SET product_id=?, item_name=?, brand=?, spec=?, unit=?, is_custom=0 WHERE id=?')
                ->execute([$product_id, $prod['name'], $prod['brand'], $prod['spec'], $prod['unit'], $item_id]);
            if ($alias !== '' && $alias !== $prod['name']) {
                try {
                    db()->prepare('INSERT IGNORE INTO product_synonyms (product_id, alias) VALUES (?,?)')->execute([$product_id, $alias]);
                } catch (PDOException $e) {}
            }
            db()->prepare('INSERT INTO audit_records (item_id, product_id, action, alias_saved, note, created_by) VALUES (?,?,?,?,?,?)')
                ->execute([$item_id, $product_id, 'map', $alias !== '' && $alias !== $prod['name'] ? 1 : 0, '清单外编辑入库-归并已有商品', $by]);
            log_action('清单外编辑入库', "{$item['month']} 项目{$item['project_id']} 「{$item['item_name']}」→ 归入已有标准商品「{$prod['name']}」");
        } else {
            db()->prepare('INSERT INTO products (line, category, name, brand, spec, unit, status) VALUES (?,?,?,?,?,?,1)')
                ->execute([$line, $category, $name, $brand, $spec, $unit]);
            $product_id = (int) db()->lastInsertId();
            db()->prepare('UPDATE purchase_items SET product_id=?, item_name=?, brand=?, spec=?, unit=?, is_custom=0 WHERE id=?')
                ->execute([$product_id, $name, $brand, $spec, $unit, $item_id]);
            if ($alias !== '' && $alias !== $name) {
                try {
                    db()->prepare('INSERT IGNORE INTO product_synonyms (product_id, alias) VALUES (?,?)')->execute([$product_id, $alias]);
                } catch (PDOException $e) {}
            }
            db()->prepare('INSERT INTO audit_records (item_id, product_id, action, alias_saved, note, created_by) VALUES (?,?,?,?,?,?)')
                ->execute([$item_id, $product_id, 'new', $alias !== '' && $alias !== $name ? 1 : 0, '清单外编辑入库-新建标准商品', $by]);
            log_action('清单外编辑入库', "{$item['month']} 项目{$item['project_id']} 「{$item['item_name']}」→ 新建标准商品「{$name}」入库");
        }
        if ($tx) db()->commit();
        return ['ok' => true, 'msg' => $mode === 'merge' ? '已归入标准商品「' . $prod['name'] . '」' : '已新建标准商品「' . $name . '」并归入'];
    } catch (\Throwable $e) {
        if ($tx) db()->rollBack();
        throw $e;
    }
}
