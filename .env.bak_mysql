# 本地开发环境配置；生产部署请复制 .env.example，不要直接上传本文件
APP_NAME=Laravel
# local=本地开发，production=宝塔正式环境
APP_ENV=local
# 本地密钥，生产环境必须使用独立 APP_KEY
APP_KEY=base64:UWxNksTCouduMniD46AIt05sGWYkbQecAT6M97dfBJY=
# 本地可以开启调试，生产必须关闭
APP_DEBUG=true
# 本地访问地址；生产改为实际 https 域名
APP_URL=http://localhost

# 语言设置
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4  # 可选：本地 PHP CLI 并发 worker 数量

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 本地 MySQL 迁移实例：3307 为本机开发端口；生产改为宝塔 MySQL 地址、端口和专用账号
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=payroll
DB_USERNAME=root
DB_PASSWORD=

# 旧 JSON 数据目录，仅迁移旧数据时使用
LEGACY_DATA_PATH=../data

# 会话存储配置；database 需要先执行数据库迁移
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 队列、文件、缓存配置；local 文件存储不会公开文件
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 邮件未接入时使用 log，不会实际发送邮件
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 云存储未接入，保持为空
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
